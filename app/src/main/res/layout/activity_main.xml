<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/overlay_surface_pressed"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/txtPcIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/overlay_accent"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnOverlayPermission"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="@string/overlay_permission_request"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOverlayStart"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="@string/overlay_start"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOverlayStop"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="@string/overlay_stop"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnEditMode"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="@string/overlay_edit_mode"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnKeySettings"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/key_settings" />

    <Button
        android:id="@+id/btnProfiles"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:text="@string/profile_settings" />

</LinearLayout>
